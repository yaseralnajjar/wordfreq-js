{
  "name": "@yaseralnajjar/wordfreq-js",
  "version": "0.1.0",
  "description": "Embedded English word frequencies with a synchronous nodewordfreq-compatible API for browsers and Node",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./global": "./dist/wordfreq.global.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "LICENSE",
    "NOTICE.md",
    "licenses/",
    "data/provenance.json",
    "README.md"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/yaseralnajjar/wordfreq-js.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node --test tests/*.test.js",
    "bench": "node scripts/bench.js",
    "verify": "npm run build && npm test && npm run bench",
    "serve:example": "node scripts/serve-example.js",
    "test:extension": "node scripts/test-extension.js"
  },
  "devDependencies": {
    "@msgpack/msgpack": "3.1.3",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "lru-cache": "11.5.3",
    "msgpackr": "1.11.5",
    "playwright-core": "1.64.1"
  }
}
